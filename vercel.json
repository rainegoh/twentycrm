{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "yarn install",
  "buildCommand": "npx nx build twenty-front && npx nx build twenty-server",
  "outputDirectory": "packages/twenty-front/build",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "memory": 2048,
      "includeFiles": "packages/twenty-server/dist/**"
    }
  },
  "rewrites": [
    { "source": "/admin-panel", "destination": "/api/index" },
    { "source": "/admin-panel/:path*", "destination": "/api/index" },
    { "source": "/app", "destination": "/api/index" },
    { "source": "/app/:path*", "destination": "/api/index" },
    { "source": "/application-registration-claim", "destination": "/api/index" },
    { "source": "/application-registration-claim/:path*", "destination": "/api/index" },
    { "source": "/apps", "destination": "/api/index" },
    { "source": "/apps/:path*", "destination": "/api/index" },
    { "source": "/auth", "destination": "/api/index" },
    { "source": "/auth/:path*", "destination": "/api/index" },
    { "source": "/client-config", "destination": "/api/index" },
    { "source": "/client-config/:path*", "destination": "/api/index" },
    { "source": "/cloudflare", "destination": "/api/index" },
    { "source": "/cloudflare/:path*", "destination": "/api/index" },
    { "source": "/emailing", "destination": "/api/index" },
    { "source": "/emailing/:path*", "destination": "/api/index" },
    { "source": "/file", "destination": "/api/index" },
    { "source": "/file/:path*", "destination": "/api/index" },
    { "source": "/file-upload", "destination": "/api/index" },
    { "source": "/file-upload/:path*", "destination": "/api/index" },
    { "source": "/files", "destination": "/api/index" },
    { "source": "/files/:path*", "destination": "/api/index" },
    { "source": "/graphql", "destination": "/api/index" },
    { "source": "/graphql/:path*", "destination": "/api/index" },
    { "source": "/healthz", "destination": "/api/index" },
    { "source": "/healthz/:path*", "destination": "/api/index" },
    { "source": "/mcp", "destination": "/api/index" },
    { "source": "/mcp/:path*", "destination": "/api/index" },
    { "source": "/metadata", "destination": "/api/index" },
    { "source": "/metadata/:path*", "destination": "/api/index" },
    { "source": "/oauth", "destination": "/api/index" },
    { "source": "/oauth/:path*", "destination": "/api/index" },
    { "source": "/open-api", "destination": "/api/index" },
    { "source": "/open-api/:path*", "destination": "/api/index" },
    { "source": "/public-assets", "destination": "/api/index" },
    { "source": "/public-assets/:path*", "destination": "/api/index" },
    { "source": "/rest", "destination": "/api/index" },
    { "source": "/rest/:path*", "destination": "/api/index" },
    { "source": "/s", "destination": "/api/index" },
    { "source": "/s/:path*", "destination": "/api/index" },
    { "source": "/webhooks", "destination": "/api/index" },
    { "source": "/webhooks/:path*", "destination": "/api/index" },
    { "source": "/.well-known", "destination": "/api/index" },
    { "source": "/.well-known/:path*", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
